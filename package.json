{
  "name": "Daisy",
  "version": "1.6.0",
  "description": "Daisy - AI voice assistant for Windows",
  "author": "Daisy",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:native && tsc && npm run copy-renderer && npm run build:settings",
    "build:native": "node scripts/build-native.cjs",
    "build:watch": "tsc --watch",
    "build:settings": "vite build --config vite.settings.config.ts",
    "copy-renderer": "node scripts/copy-renderer.cjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run dist:win:x64",
    "dist:win:x64": "npm run build && electron-builder --win --x64",
    "dist:win:arm64": "npm run build && electron-builder --win --arm64",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1",
    "typescript": "^5.8.3",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "dotenv": "^16.5.0",
    "duck-duck-scrape": "^2.2.7",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.42.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.42.2",
    "node-edge-tts": "^1.2.10",
    "node-global-key-listener": "^0.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.daisy.app",
    "productName": "Daisy",
    "directories": {
      "output": "releases"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!.env",
      "!.env.*",
      "!**/.env",
      "!**/.env.*",
      "!daisy.env",
      "!daisy.env.*",
      "!**/daisy.env",
      "!**/daisy.env.*",
      "!**/node-global-key-listener/bin/**"
    ],
    "afterPack": "scripts/after-pack-sign.cjs",
    "asarUnpack": [
      "assets/bin/**",
      "assets/lib/**",
      "assets/models/**"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "assets/icon.icns",
        "to": "icon.icns"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daisy"
    }
  }
}
